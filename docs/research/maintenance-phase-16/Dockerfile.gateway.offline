# syntax=docker/dockerfile:1
# SPDX-License-Identifier: AGPL-3.0-or-later
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=bind,from=simurgh_npm_cache,target=/tmp/npm-cache,rw \
    npm ci --offline --cache=/tmp/npm-cache --omit=dev --no-audit --no-fund
COPY --chown=node:node . .
ENV NODE_ENV=production \
    SIMURGH_DEMO_MODE=1 \
    SIMURGH_GATEWAY_PROVIDER_MODE=mock \
    SIMURGH_LIVE_PROVIDER_ENABLED=false \
    SIMURGH_LLM_PROVIDER=mock \
    PORT=33030
# Non-root: the node image ships an unprivileged `node` user.
USER node
EXPOSE 33030
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||33030)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]

{
  "name": "simurgh",
  "version": "0.4.18",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Provider-agnostic verifiable containment research for AI agents, with offline evidence verification and an opt-in OpenAI Responses experiment. Includes the historical academic and device-integrity prototype.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "assurance:phase3": "PYTHONDONTWRITEBYTECODE=1 python3 tools/assurance-eval/report.py",
    "test:phase3": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tools/assurance-eval/tests -v",
    "assurance:connector": "PYTHONDONTWRITEBYTECODE=1 python3 tools/assurance-connector/study.py",
    "test:connector": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tools/assurance-connector/tests -v",
    "assurance:hardened": "PYTHONDONTWRITEBYTECODE=1 python3 tools/assurance-hardening/demo.py",
    "test:hardening": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tools/assurance-hardening/tests -v",
    "assurance:run": "node tools/assurance-lab/cli.mjs run",
    "assurance:verify": "node tools/assurance-lab/cli.mjs verify",
    "test:assurance": "node --test tests/unit/assuranceLab/*.test.js",
    "test:assurance-sdk-bridge": "node --test tests/unit/assuranceSdk/*.test.js",
    "openai:offline": "node tools/openai-readiness/run.mjs",
    "openai:live": "node tools/openai-readiness/run.mjs --live",
    "openai:verify": "node tools/openai-readiness/verify.mjs",
    "test:openai": "node --test tests/unit/openaiReadiness/*.test.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/unit/*.test.js tests/unit/**/*.test.js tests/unit/**/**/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:stage5p": "node --test tests/unit/llmShield/stage5p/*.test.js",
    "census:stage5p": "node tools/simurgh-attestation/stage5p/node/measureStage5pLaneACensus.mjs --phase=draft",
    "census:stage5p:release": "node tools/simurgh-attestation/stage5p/node/measureStage5pLaneACensus.mjs --phase=release",
    "census:stage5p:rawcodes": "node tools/simurgh-attestation/stage5p/node/measureStage5pRawCodes.mjs",
    "test:stage5q": "node --test tests/unit/llmShield/stage5q/*.test.js",
    "census:stage5q:static": "node tools/simurgh-attestation/stage5q/node/measureStaticCensus.mjs",
    "census:stage5q:runtime": "node tools/simurgh-attestation/stage5q/node/measureRuntimeCensus.mjs",
    "census:stage5q:gate": "node tools/simurgh-attestation/stage5q/node/measureGateCensus.mjs",
    "census:stage5q:coverage": "node tools/simurgh-attestation/stage5q/node/measureQ0Coverage.mjs",
    "stage5q:roles": "node tools/simurgh-attestation/stage5q/node/checkRoles.mjs",
    "stage5q:commit-closure": "node tools/simurgh-attestation/stage5q/node/commitClosure.mjs",
    "stage5q:mutants": "node tools/simurgh-attestation/stage5q/node/runMutationSelfProof.mjs",
    "stage5q:attest": "node tools/simurgh-attestation/stage5q/node/attestation.mjs",
    "stage5q:transition": "node tools/simurgh-attestation/stage5q/node/verifyTransition.mjs",
    "stage5q:proofs": "scripts/check-stage5q-proofs.sh",
    "stage5q:probe-f002": "node tools/simurgh-attestation/stage5q/node/probeLaneCVacuity.mjs",
    "stage5q:probe-f003": "node tools/simurgh-attestation/stage5q/node/probeImportWrites.mjs",
    "stage5q:findings": "node tools/simurgh-attestation/stage5q/node/buildFindingLedger.mjs",
    "stage5q:packs": "node tools/simurgh-attestation/stage5q/node/runStagePacks.mjs",
    "stage5q:parity": "node tools/simurgh-attestation/stage5q/node/runCrossRuntimeParity.mjs",
    "stage5q:tray": "node tools/simurgh-attestation/stage5q/node/buildTray.mjs",
    "stage5q:reproduce": "scripts/reproduce-llm-shield-stage5q.sh",
    "test:stage5r": "node --test tests/unit/llmShield/stage5r/*.test.js",
    "stage5r:corpus": "node tools/simurgh-attestation/stage5r/node/verifyFamilyCorpus.mjs",
    "stage5r:campaign": "node tools/simurgh-attestation/stage5r/node/runTranche.mjs",
    "stage5r:ledgers": "node tools/simurgh-attestation/stage5r/node/buildDeltaLedger.mjs && node tools/simurgh-attestation/stage5r/node/buildFindingLedger.mjs",
    "stage5r:attest": "node tools/simurgh-attestation/stage5r/node/attestStage5r.mjs",
    "stage5r:verify": "node tools/simurgh-attestation/stage5r/node/verifyAttestation.mjs",
    "stage5r:proofs": "bash scripts/check-stage5r-proofs.sh",
    "stage5r:reproduce": "bash scripts/reproduce-llm-shield-stage5r.sh",
    "assurance:phase4": "PYTHONDONTWRITEBYTECODE=1 python3 tools/assurance-reproduce/reproduce.py",
    "test:phase4": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tools/assurance-reproduce/tests -v",
    "assurance:phase5": "PYTHONDONTWRITEBYTECODE=1 python3 tools/assurance-recovery/evidence.py",
    "test:phase5": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tools/assurance-recovery/tests -v",
    "test:phase6": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tools/assurance-signals/tests -v",
    "assurance:phase6": "PYTHONDONTWRITEBYTECODE=1 python3 tools/assurance-signals/evidence.py",
    "test:phase7": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tools/assurance-context/tests -v",
    "assurance:phase7": "PYTHONDONTWRITEBYTECODE=1 python3 tools/assurance-context/evidence.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "acorn": "8.17.0",
    "prettier": "^3.8.3"
  }
}

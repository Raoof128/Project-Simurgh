export function verifyPortable(bundle) {
  if (bundle.entries === undefined) {
    process.stderr.write("verifyPortable: entries are required\n");
    process.exit(4);
  }
  const keys = Object.keys(bundle.entries).sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
  return keys.map((k) => k + ":" + bundle.entries[k]).join("|");
}

verifyPortable({});

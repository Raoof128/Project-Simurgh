      "why": "the ordinary case, with a trailing newline already present",
      "bytes": [99, 111, 110, 115, 116, 32, 120, 32, 61, 32, 49, 59, 10]
    },
    {
      "id": "src-02-no-trailing-lf",
      "kind": "source_span_digest",
      "why": "exactly one trailing LF is ADDED when absent",

{
  "schema": "simurgh.vsr.parity-vectors.v1",
  "note": "The frozen cross-runtime vectors. Chosen for the cases where Node, Python and a browser actually diverge — line endings, non-ASCII, odd-length Merkle levels, unicode key ordering — rather than for cases where any three implementations would agree by accident. `bytes` are byte arrays, never strings: a string has already lost the distinction between malformed UTF-8 and U+FFFD.",
  "excluded_from_the_surface": [
    "floating-point numbers — JSON.stringify and json.dumps disagree on representation",
    "non-BMP escaping — the two disagree on surrogate handling",
    "anything reading the filesystem, the clock or a process"
  ],

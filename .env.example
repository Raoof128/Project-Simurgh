ANTHROPIC_API_KEY=sk-ant-...
PORT=3030

# Optional — model selection (default: claude-sonnet-4-6)
# Set to claude-haiku-4-5 for the cost-sensitive deployment tier.
SIMURGH_MODEL=claude-sonnet-4-6

# Optional — force the local heuristic fallback (no Anthropic calls).
# Useful for offline demos. Default: 0.
SIMURGH_DEMO_MODE=0

# REQUIRED in non-demo mode. Native helper auth — must match the --secret
# flag passed to simurgh-helper. Choose a long, random value. The server
# will refuse to start in non-demo mode if this is unset.
# Generate with:  openssl rand -hex 32
SIMURGH_HELPER_SECRET=

# REQUIRED in production. HMAC key used to sign the tamper-evident audit chain.
# If unset the server generates an ephemeral key per restart, which silently
# invalidates every previously exported audit chain on each restart.
# Generate with:  openssl rand -hex 32
SIMURGH_AUDIT_SECRET=

# REQUIRED in production. Pepper for the student-identifier pseudonym returned by
# /api/exams/:id/join. Keep it distinct from SIMURGH_AUDIT_SECRET. If unset the server falls
# back to SIMURGH_AUDIT_SECRET, then to a public development string. The HMAC key is derived
# from this value with a fixed label ("simurgh/student-id/v2"), so it is never used as-is.
# Generate with:  openssl rand -hex 32
SIMURGH_STUDENT_ID_PEPPER=

# REQUIRED in production. Token gating the instructor view, dashboard,
# audit export, sessions list, and SSE stream. If unset outside demo mode
# the server refuses to start (exit 78). SIMURGH_DEMO_MODE=1 opens every
# instructor route and ignores this token entirely.
# Generate with:  openssl rand -hex 24
SIMURGH_INSTRUCTOR_TOKEN=

# Optional — restrict CORS to a specific origin. Default: "*" (any origin).
# Example: SIMURGH_ALLOWED_ORIGIN=https://exam.example.edu
SIMURGH_ALLOWED_ORIGIN=*

# REQUIRED in non-demo mode. HMAC key used to sign student session tokens
# (issued at /api/exams/:id/join, required on lifecycle + joined-session
# telemetry POSTs). Must be distinct from the audit, helper, and instructor
# secrets. The server refuses to start in non-demo mode if this is unset.
# Generate with:  openssl rand -hex 32
SIMURGH_SESSION_SIGNING_SECRET=

# Optional — risk scoring / Claude gating
# Model-call governance (31 October 2026 audit). SIMURGH_SCORING_MODE=local never calls the
# model; the three CLAUDE_ON_* flags gate calls per risk level; the process-wide budget bounds
# spend whatever the session count; tokenless (legacy) sessions never reach the model unless
# SIMURGH_MODEL_FOR_LEGACY_SESSIONS=1.
SIMURGH_SCORING_MODE=hybrid
SIMURGH_CLAUDE_ON_SAFE=false
SIMURGH_CLAUDE_ON_WARNING=true
SIMURGH_CLAUDE_ON_CRITICAL=true
SIMURGH_MODEL_CALLS_PER_MINUTE=120
SIMURGH_MODEL_FOR_LEGACY_SESSIONS=0
# Behind a TLS proxy set true (or an Express trust-proxy value) so per-IP limits see clients.
SIMURGH_TRUST_PROXY=
# Wrong instructor tokens per IP per minute before 429; SSE clients; gateway export guard (1/0).
SIMURGH_INSTRUCTOR_AUTH_FAILURES_PER_MINUTE=30
SIMURGH_MAX_SSE_CLIENTS=200
SIMURGH_GATEWAY_EXPORT_GUARD=1

# Optional — require signed localhost daemon proofs on telemetry.
# Keep false for browser-only demos; set true for hardened/native-required exams.
SIMURGH_REQUIRE_DAEMON=false

# Optional — telemetry validation windows (ms)
SIMURGH_TIMESTAMP_SKEW_MS=30000
SIMURGH_TIMESTAMP_FUTURE_MS=5000

# Optional — JSON body limit (default 32kb)
SIMURGH_JSON_LIMIT=32kb

# Optional — capacity guards
SIMURGH_MAX_SESSIONS=10000
# Slots that tokenless /api/telemetry sessions (the legacy direct path) may hold, so a flood of
# fresh sessionIds cannot starve /api/exams/:id/join. Default: a quarter of SIMURGH_MAX_SESSIONS.
# SIMURGH_MAX_LEGACY_SESSIONS=2500
# Per-IP, per-minute limit on tokenless telemetry that creates a new session. Default: 60.
# SIMURGH_LEGACY_TELEMETRY_SESSION_RATE_MAX=60
# Per-IP, per-minute limit on POST /api/llm-shield/sessions. Default: 60.
# SIMURGH_LLM_SHIELD_SESSION_RATE_MAX=60

# Optional — session token TTL (ms, default 4 hours)
SIMURGH_SESSION_TTL_MS=14400000

# Optional — privacy debug toggles (do NOT enable in production)
SIMURGH_DEBUG_RAW_PROCESS_NAMES=false
SIMURGH_DEBUG_RAW_WINDOW_TITLES=false

# Voting pilot — MQ Persian Society research pilot (Phase A/B/C)
# REQUIRED when running the voting pilot routes.
# Generate with:  openssl rand -hex 32
SIMURGH_VOTING_PILOT_PEPPER=replace-with-32-char-random-secret
SIMURGH_VOTING_PILOT_TOKEN_SECRET=replace-with-32-char-random-secret
# Provenance is operator-set, never taken from the request (31 October 2026 audit).
SIMURGH_VOTING_PILOT_DATA_SOURCE=researcher_self_pilot
SIMURGH_VOTING_PILOT_SYNTHETIC=false
SIMURGH_VOTING_PILOT_MAX_SESSIONS=5000
SIMURGH_VOTING_PILOT_CONSENT_RATE_MAX=60

# Set to "true" to enforce server-side collection closure (Phase C closed).
# When true, consent/accept, submit, and withdraw return 410 Gone.
# Report export remains available for existing sessions.
SIMURGH_VOTING_PILOT_COLLECTION_CLOSED=false

# Banking Shield Phase A — synthetic banking-adjacent research demo.
# REQUIRED when running the banking pilot routes.
# Generate with:  openssl rand -hex 32
SIMURGH_BANKING_PILOT_PEPPER=replace-with-32-char-random-secret
SIMURGH_BANKING_PILOT_TOKEN_SECRET=replace-with-32-char-random-secret

# Set to "true" to enforce server-side collection closure.
# When true, consent/accept, submit, and withdraw return 410 Gone before auth.
# Report, audit, and verify exports remain token-protected for existing sessions.
SIMURGH_BANKING_PILOT_COLLECTION_CLOSED=false

# Optional — runtime Sonnet narrative support for Banking Shield.
# Default/off for Phase A; sanitisation is tested locally without external calls.
# The code reads SIMURGH_BANKING_PILOT_AI_EXPLAIN (ENABLE_NARRATIVE was never read).
SIMURGH_BANKING_PILOT_AI_EXPLAIN=false

# Optional — Banking Shield abuse limits (defaults shown).
# Per-IP fixed-window rate limits (requests per minute) and the in-memory
# session capacity cap. Consent returns 503 banking_session_capacity_reached
# at the cap and 429 rate_limited above the per-IP rate.
# SIMURGH_BANKING_PILOT_CONSENT_RATE_MAX=60
# SIMURGH_BANKING_PILOT_WRITE_RATE_MAX=120
# SIMURGH_BANKING_PILOT_READ_RATE_MAX=240
# SIMURGH_BANKING_PILOT_MAX_SESSIONS=5000

# Stage 3A-alpha LLM Shield — required to enable /api/llm-shield routes.
# Used to derive the session-token key and the per-session audit-chain HMAC key.
SIMURGH_LLM_SHIELD_SECRET=change-me-llm-shield-secret-32-chars

# SPDX-License-Identifier: AGPL-3.0-or-later
# Pinned by manifest-list digest (resolved from Docker Hub on 31 October 2026); the tag alone moves.
FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --chown=node:node . .
ENV NODE_ENV=production \
    SIMURGH_DEMO_MODE=1 \
    SIMURGH_GATEWAY_PROVIDER_MODE=mock \
    SIMURGH_LIVE_PROVIDER_ENABLED=false \
    SIMURGH_LLM_PROVIDER=mock \
    PORT=33030
# Non-root: the node image ships an unprivileged `node` user.
USER node
EXPOSE 33030
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||33030)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
